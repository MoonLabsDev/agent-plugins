{
  "description": "Book completed Codex turns for repositories explicitly opted into ml-track.",
  "hooks": {
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/ml-track.mjs\" hook stop", "commandWindows": "node -e \"process.argv.splice(1,0,'ml-track');import(require('url').pathToFileURL(require('path').join(process.env.PLUGIN_ROOT,'bin','ml-track.mjs')).href)\" hook stop", "timeout": 15 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/ml-track.mjs\" hook stop", "commandWindows": "node -e \"process.argv.splice(1,0,'ml-track');import(require('url').pathToFileURL(require('path').join(process.env.PLUGIN_ROOT,'bin','ml-track.mjs')).href)\" hook stop", "timeout": 3 }] }]
  }
}
